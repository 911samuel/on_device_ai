/android/app/release

# Widget Preview related
.widget_preview/

# Model weights are NOT committed. They are large (17 MB), and they are exactly
# reproducible: tool/fetch_models.sh downloads them from Google's public
# storage, and their SHA-256 digests are asserted both in ModelCatalog (at app
# startup) and in test/model_catalog_test.dart. Run ./tool/fetch_models.sh after
# cloning. Binary blobs that a script can rebuild byte-for-byte do not belong in
# git history.
assets/models/*.tflite
